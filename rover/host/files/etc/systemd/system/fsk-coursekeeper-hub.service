[Unit]
Description=Coursekeeper rover hub
After=network-online.target podman.socket
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/hub-run
ExecStop=/usr/bin/podman stop -t 10 hub
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target default.target
